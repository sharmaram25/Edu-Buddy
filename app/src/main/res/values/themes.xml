<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: on Android 8.x BiometricPrompt shows an AppCompat fingerprint dialog,
         which crashes under a non-AppCompat theme. -->
    <style name="Theme.EduBuddy" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.EduBuddy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.EduBuddy</item>
    </style>
</resources>
